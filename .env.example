# Copy to .env. Docker Compose loads it automatically; never commit real secrets.
DJANGO_SECRET_KEY=dev-only-change-before-publishing-this-demo
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=false
POSTGRES_DB=axon_booking
POSTGRES_USER=axon
POSTGRES_PASSWORD=axon_local_only
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
TELEGRAM_BOT_TOKEN=
# Public username, without @, for the demo landing page.
TELEGRAM_BOT_USERNAME=
# Optional: a private chat or group where the bot can send administrator notifications.
TELEGRAM_ADMIN_CHAT_ID=
STUDIO_NAME=Демо Axon
STUDIO_TIME_ZONE=Europe/Berlin
BOOKING_HORIZON_DAYS=14
SLOT_STEP_MINUTES=15
