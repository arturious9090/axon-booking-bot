      "css": ".ds-field-label{display:block;margin-bottom:8px;color:var(--body-medium-color,#526157);font-family:var(--font-family-primary,sans-serif);font-size:13px;font-weight:500;}.ds-field{padding:9px 11px;min-height:38px;max-width:100%;border:1px solid #cbd5c5;border-radius:6px;background:var(--axon-surface,#ffffff);color:var(--body-fg,#26332a);font-family:var(--font-family-primary,sans-serif);font-size:13px;caret-color:var(--primary,#36533b);}.ds-field:focus-visible{outline:2px solid #54783d;outline-offset:3px;}"
    },
    {
      "name": "Admin navigation",
      "kind": "nav",
      "refersTo": "admin-navigation",
      "description": "Labelled SVG navigation with pale green current-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Рабочие разделы\"><a href=\"#\" aria-current=\"page\" class=\"ds-nav-current\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M7 3v4m10-4v4M3 11h18M7 15h2m6 0h2M7 18h2\"/></svg>Расписание</a><a href=\"#\">Услуги</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;font-family:var(--font-family-primary,sans-serif);}.ds-nav a{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:8px;font-size:13px;color:var(--body-medium-color,#526157);text-decoration:none;}.ds-nav a:hover{background:#e7ede1;color:var(--body-fg,#26332a);}.ds-nav a.ds-nav-current{background:#dfe9d5;color:#2c492f;font-weight:600;}.ds-nav a:focus-visible{outline:2px solid #54783d;outline-offset:3px;}"
    },
    {
      "name": "Admin status badge",
      "kind": "chip",
      "refersTo": "admin-status",
      "description": "Noninteractive state label; do not turn it into a filter chip.",
      "html": "<span class=\"ds-status\">Активен</span><span class=\"ds-status ds-status-inactive\">Неактивен</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;border-radius:5px;padding:3px 8px;font-family:var(--font-family-primary,sans-serif);font-size:11px;font-weight:500;background:var(--axon-accent-soft,#e8efdf);color:var(--primary,#36533b);white-space:nowrap;}.ds-status-inactive{background:#f0f1ed;color:var(--axon-muted,#647164);}"
    },
    {
      "name": "Admin working panel",
      "kind": "card",
      "refersTo": "admin-panel",
      "description": "Flat white working surface, represented by the calendar toolbar.",
      "html": "<section class=\"ds-panel\" aria-label=\"Управление календарём\"><h2 class=\"ds-panel-title\">Управление календарём</h2></section>",
      "css": ".ds-panel{padding:20px;background:var(--axon-surface,#ffffff);border:1px solid var(--border-color,#d9e0d5);border-radius:var(--axon-radius,12px);font-family:var(--font-family-primary,sans-serif);}.ds-panel-title{font-size:16px;font-weight:600;color:var(--body-fg,#26332a);margin:0;}"
    },
