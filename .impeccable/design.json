  "narrative": {
    "northStar": "Axon · рабочее расписание",
    "overview": "Axon Admin is a restrained, light working environment: pale green selection, white forms and tables, dark green actions, and quiet neutral framing. The confirmed direction is clear and intuitive rather than ornamental. The system extends Django Admin and keeps its functional forms and permission-aware navigation.\n\nThis document records the shipped source. Tokens prefixed `admin-` apply to `static/booking/admin.css` and `templates/admin/`; they are not universal replacements for the public demo. The existing landing page in `static/booking/site.css` and `templates/booking/home.html` retains its own warmer paper, lime accent, Manrope typography, DM Sans wordmark, and illustrative chat treatment. Landing tokens are explicitly prefixed `landing-`.",
    "keyCharacteristics": [
      "Light neutral background with white working surfaces.",
      "Dark green actions and pale green selection.",
      "Compact, readable administration with explicit labels and visible focus.",
      "Separate, preserved visual treatment for the public demo."
    ],
    "rules": [
      {
        "name": "Scoped Palettes",
        "body": "Use admin tokens on administrative screens and landing tokens on the public demo; shared green character does not make the two palettes interchangeable.",
        "section": "colors"
      },
      {
        "name": "Color with Meaning",
        "body": "Reserve red for errors and destructive confirmation; show status in words as well as color.",
        "section": "colors"
      },
      {
        "name": "Flat Working Surfaces",
        "body": "Admin surfaces use borders and tonal changes to establish hierarchy, without decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use white working surfaces and pale green selection within the admin palette.",
      "Do pair status color with readable text and retain visible keyboard focus.",
      "Do let the admin header, filters, and actions wrap on narrow screens.",
      "Do preserve the public demo’s separate typography, palette, and existing illustration."
    ],
    "donts": [
      "Don’t apply admin tokens globally to the public landing page.",
      "Don’t replace real schedule information with decorative analytics or invented activity.",
      "Don’t remove field labels, confirmation context, permission checks, or native form behavior for visual simplicity.",
      "Don’t introduce decorative motion into administration."
    ]
  }
