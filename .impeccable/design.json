      "html": "<a href=\"#\" class=\"ds-visit\"><span class=\"ds-visit-time\">Время визита</span><strong>Имя клиента</strong><span>Название услуги</span></a>",
      "css": ".ds-visit{display:flex;flex-direction:column;gap:4px;background:var(--axon-accent-soft,#e8efdf);color:var(--primary,#36533b);border-radius:7px;margin-top:10px;padding:9px 8px;overflow-wrap:anywhere;font-family:var(--font-family-primary,sans-serif);text-decoration:none;}.ds-visit:hover{background:#dce8cf;color:var(--link-hover-color,#243e29);}.ds-visit strong{font-size:11px;line-height:1.4;}.ds-visit>span{font-size:10px;line-height:1.4;}.ds-visit-time{font-variant-numeric:tabular-nums;font-weight:600;}.ds-visit:focus-visible{outline:2px solid #54783d;outline-offset:3px;}"
    }
